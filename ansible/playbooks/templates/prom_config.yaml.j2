scrape_configs:
  - job_name: 'vicky_logs'
    metrics_path: /metrics
    scrape_interval: 10s
    static_configs:
      - targets:
          - 'vicky:9428'
        labels:
          instance: 'vicky-logs'

  - job_name: 'nodes'
    metrics_path: /metrics
    scrape_interval: 10s
    static_configs:
{% for target in monitoring_node_exporter_targets %}
      - targets:
          - '{{ target.address }}'
        labels:
          instance: '{{ target.instance }}'
{% endfor %}

  - job_name: 'cadvisor'
    metrics_path: /metrics
    scrape_interval: 10s
    static_configs:
{% for target in monitoring_cadvisor_targets %}
      - targets:
          - '{{ target.address }}'
        labels:
          instance: '{{ target.instance }}'
{% endfor %}

  - job_name: 'unifipoller'
    scrape_interval: 30s
    static_configs:
      - targets: ['unpoller:9130']

  - job_name: 'pve-exporter'
    metrics_path: /pve
    static_configs:
      - targets: ['192.168.1.206']
        labels:
          exporter_address: '192.168.1.55:9221'
      - targets: ['192.168.1.207']
        labels:
          exporter_address: '192.168.1.170:9221'
      - targets: ['192.168.1.208']
        labels:
          exporter_address: '192.168.1.254:9221'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - source_labels: [exporter_address]
        target_label: __address__
