#cloud-config
hostname: ${hostname}
apt:
  primary:
    - arches: [amd64]
      uri: http://mirror.sg.gs/ubuntu/
users:
  - name: ubuntu
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}
package_update: true
packages:
  - qemu-guest-agent
runcmd:
  - systemctl enable --now qemu-guest-agent
