{
  "title": "Proxmox VE",
  "schemaVersion": 36,
  "__inputs": [],
  "editable": true,
  "tags": ["proxmox"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "ClickHouse instance",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "grafana-clickhouse-datasource",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Node CPU Usage",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percentunit",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "transformations": [
        { "id": "prepareTimeSeries", "options": { "format": "many" } }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
          "queryType": "sql",
          "format": 0,
          "editorType": "sql",
          "rawSql": "SELECT\n  $__timeInterval(TimeUnix) as time,\n  Attributes['node'] as node,\n  avg(Value) as value\nFROM otel_metrics_gauge\nWHERE ServiceName = 'proxmox-ve'\n  AND MetricName = 'proxmox_node_cpustat_used'\n  AND $__timeFilter(TimeUnix)\nGROUP BY node, time\nORDER BY time"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Node Memory (Used vs Total)",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "bytes",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "transformations": [
        { "id": "prepareTimeSeries", "options": { "format": "many" } }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
          "queryType": "sql",
          "format": 0,
          "editorType": "sql",
          "rawSql": "SELECT\n  $__timeInterval(TimeUnix) as time,\n  concat(Attributes['node'], ' - ', if(MetricName = 'proxmox_node_memory_memused', 'used', 'total')) as series,\n  avg(Value) as value\nFROM otel_metrics_gauge\nWHERE ServiceName = 'proxmox-ve'\n  AND MetricName IN ('proxmox_node_memory_memused', 'proxmox_node_memory_memtotal')\n  AND $__timeFilter(TimeUnix)\nGROUP BY Attributes['node'], MetricName, time\nORDER BY time"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Storage Used vs Total",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "bytes",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "transformations": [
        { "id": "prepareTimeSeries", "options": { "format": "many" } }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
          "queryType": "sql",
          "format": 0,
          "editorType": "sql",
          "rawSql": "SELECT\n  $__timeInterval(TimeUnix) as time,\n  concat(Attributes['node'], '/', Attributes['storage'], ' - ', if(MetricName = 'proxmox_storage_used', 'used', 'total')) as series,\n  avg(Value) as value\nFROM otel_metrics_gauge\nWHERE ServiceName = 'proxmox-ve'\n  AND MetricName IN ('proxmox_storage_used', 'proxmox_storage_total')\n  AND $__timeFilter(TimeUnix)\nGROUP BY Attributes['node'], Attributes['storage'], MetricName, time\nORDER BY time"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Node Network (cumulative bytes)",
      "description": "Raw cumulative counters, not rate. Slope = throughput.",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "bytes",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "transformations": [
        { "id": "prepareTimeSeries", "options": { "format": "many" } }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
          "queryType": "sql",
          "format": 0,
          "editorType": "sql",
          "rawSql": "SELECT\n  $__timeInterval(TimeUnix) as time,\n  concat(Attributes['node'], '/', Attributes['device'], ' ', if(MetricName = 'proxmox_node_network_receive_total', 'rx', 'tx')) as series,\n  max(Value) as value\nFROM otel_metrics_sum\nWHERE ServiceName = 'proxmox-ve'\n  AND MetricName IN ('proxmox_node_network_receive_total', 'proxmox_node_network_transmit_total')\n  AND $__timeFilter(TimeUnix)\nGROUP BY Attributes['node'], Attributes['device'], MetricName, time\nORDER BY time"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "VM CPU Usage",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percentunit",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "transformations": [
        { "id": "prepareTimeSeries", "options": { "format": "many" } }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
          "queryType": "sql",
          "format": 0,
          "editorType": "sql",
          "rawSql": "SELECT\n  $__timeInterval(TimeUnix) as time,\n  Attributes['name'] as vm,\n  avg(Value) as value\nFROM otel_metrics_gauge\nWHERE ServiceName = 'proxmox-ve'\n  AND MetricName = 'proxmox_vm_cpu'\n  AND $__timeFilter(TimeUnix)\nGROUP BY vm, time\nORDER BY time"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "VM Memory (Used vs Max)",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "bytes",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "transformations": [
        { "id": "prepareTimeSeries", "options": { "format": "many" } }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
          "queryType": "sql",
          "format": 0,
          "editorType": "sql",
          "rawSql": "SELECT\n  $__timeInterval(TimeUnix) as time,\n  concat(Attributes['name'], ' - ', if(MetricName = 'proxmox_vm_mem', 'used', 'max')) as series,\n  avg(Value) as value\nFROM otel_metrics_gauge\nWHERE ServiceName = 'proxmox-ve'\n  AND MetricName IN ('proxmox_vm_mem', 'proxmox_vm_maxmem')\n  AND $__timeFilter(TimeUnix)\nGROUP BY Attributes['name'], MetricName, time\nORDER BY time"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Node Uptime",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "s", "mappings": [] },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
          "queryType": "sql",
          "format": 1,
          "editorType": "sql",
          "rawSql": "SELECT\n  Attributes['node'] as node,\n  max(Value) as uptime_seconds\nFROM otel_metrics_gauge\nWHERE ServiceName = 'proxmox-ve'\n  AND MetricName = 'proxmox_node_uptime'\n  AND $__timeFilter(TimeUnix)\nGROUP BY node\nORDER BY node"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "VM Uptime",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "s", "mappings": [] },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${datasource}" },
          "queryType": "sql",
          "format": 1,
          "editorType": "sql",
          "rawSql": "SELECT\n  Attributes['name'] as vm,\n  max(Value) as uptime_seconds\nFROM otel_metrics_gauge\nWHERE ServiceName = 'proxmox-ve'\n  AND MetricName = 'proxmox_vm_uptime'\n  AND $__timeFilter(TimeUnix)\nGROUP BY vm\nORDER BY vm"
        }
      ]
    }
  ]
}
